    {
      "title": "Autocomplete Google Amphitheatre address prefix",
      "steps": [
        {
          "id": "step-1",
          "kind": "prompt",
          "prompt": "I am typing 1600 Amphitheatre Pkwy into the search bar. Show autocomplete candidates for the prefix '1600 Amphitheatre Pkw'."
        },
        {
          "id": "step-expect-0",
          "kind": "assert",
          "assertion": {
            "type": "toolCalledWith",
            "toolName": "autocomplete",
            "args": {
              "args": {
                "q": "1600 Amphitheatre Pkw"
              },
              "argumentMatching": "partial"
            }
          }
        },
        {
          "id": "step-expect-1",
          "kind": "assert",
          "assertion": {
            "type": "toolResultContains",
            "needle": "Amphitheatre",
            "caseSensitive": false,
            "toolName": "autocomplete",
            "role": "advisory"
          }
        },
        {
          "id": "step-expect-2",
          "kind": "assert",
          "assertion": {
            "type": "noToolErrors"
          }
        }
      ],
      "iterations": 1,
      "isNegative": false
    },

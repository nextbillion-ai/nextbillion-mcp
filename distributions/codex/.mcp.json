{
  "mcpServers": {
    "nextbillion": {
      "command": "npx",
      "args": ["-y", "nextbillion-mcp@0.2.1"],
      "env": {
        "NBAI_API_KEY": "${NBAI_API_KEY}",
        "NBAI_IMAGE_DIR": "tmp",
        "npm_config_audit": "false",
        "npm_config_fund": "false",
        "npm_config_update_notifier": "false"
      }
    }
  }
}

{
  "name": "nextbillion-mcp",
  "version": "0.1.0",
  "description": "MCP server exposing NextBillion.ai location APIs (geocoding, places, routing, maps) as tools for AI agents",
  "license": "UNLICENSED",
  "type": "module",
  "bin": {
    "nextbillion-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nextbillion-ai/nextbillion-mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "nextbillion",
    "geocoding",
    "routing",
    "maps"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/unit tests/conformance",
    "test:e2e": "vitest run tests/e2e",
    "dev": "tsx src/index.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.0",
    "typescript": "^7.0.0",
    "vitest": "^4.1.0"
  }
}
